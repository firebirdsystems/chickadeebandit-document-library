{
  "id": "document-library",
  "contexts": ["household", "shared_space"],
  "name": "Document Library",
  "version": "1.0.0",
  "description": "Versioned repository for governing documents — CC&Rs, bylaws, architectural guidelines, rules — plus a chronological archive of board meeting agendas and minutes. The Board uploads and versions files; everyone can always access the current governing docs.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["documents", "governance", "hoa", "bylaws", "minutes", "board"],
  "icon": "📚",
  "storage": "db",
  "db_encryption": "off",
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "member_references": {
    "documents": { "column": "created_by", "on_removed": "keep" },
    "document_versions": { "column": "uploaded_by", "on_removed": "keep" }
  },
  "resource_limits": { "max_db_bytes": 209715200 },
  "nav": { "label": "Library" },
  "row_policies": {
    "documents": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "adult_values": [],
      "write_owner_only": true,
      "insert_privileged_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "board_group_id" }]
    },
    "document_versions": {
      "kind": "inherit_visibility",
      "fk_column": "document_id",
      "parent_table": "documents",
      "writer_column": "uploaded_by",
      "insert_privileged_only": true
    },
    "settings": {
      "kind": "app_config"
    },
    "app_settings": {
      "kind": "adult_only"
    }
  },
  "admin_config": {
    "settings_table": "settings",
    "keys": ["board_group_id"]
  },
  "agenda": {
    "kind": "event",
    "label": "Meeting",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, NULLIF(description, '') AS subtitle, meeting_date AS when_at FROM app_document_library__documents WHERE category = 'meeting' AND doc_type = 'agenda' AND meeting_date = :today LIMIT 10"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_document_library__documents WHERE category = 'meeting' AND doc_type = 'agenda' AND meeting_date >= :today AND meeting_date <= date(:today, '+13 days') LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "meetings in the next two weeks",
      "severity": "info"
    }
  },
  "publishes": ["document.published", "document.revised"],
  "publish_acls": {
    "document.published": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "board_group_id" }
    },
    "document.revised": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "board_group_id" }
    }
  },
  "file_acls": {
    "write": { "require_group_setting": { "settings_table": "settings", "settings_key": "board_group_id" } }
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["governing_documents", "meeting_archive"]
  }
}
