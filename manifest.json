{
  "id": "document-library",
  "contexts": [
    "household",
    "shared_space"
  ],
  "name": "Document Library",
  "version": "1.1.0",
  "description": "Versioned repository for governing documents \u2014 CC&Rs, bylaws, architectural guidelines, rules \u2014 plus a chronological archive of board meeting agendas and minutes. The Board uploads and versions files; everyone can always access the current governing docs.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": [
    "documents",
    "governance",
    "hoa",
    "bylaws",
    "minutes",
    "board"
  ],
  "icon": "\ud83d\udcda",
  "storage": "db",
  "preload": {
    "settings": {"sql": "SELECT value AS board_group_id FROM app_document_library__settings WHERE key = 'board_group_id' LIMIT 1"},
    "documents": {"sql": "SELECT * FROM app_document_library__documents ORDER BY title"}
  },
  "db_encryption": "off",
  "db_plaintext_columns": ["version_number"],
  "data_access": {
    "reads": [
      "family.members",
      "family.groups"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "member_references": {
    "documents": {
      "column": "created_by",
      "on_removed": "keep"
    },
    "document_versions": {
      "column": "uploaded_by",
      "on_removed": "keep"
    }
  },
  "resource_limits": {
    "max_db_bytes": 209715200
  },
  "nav": {
    "label": "Library"
  },
  "row_policies": {
    "documents": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": [
        "everyone"
      ],
      "adult_values": [],
      "write_owner_only": true,
      "insert_privileged_only": true,
      "privileged_groups": [
        {
          "settings_table": "settings",
          "settings_key": "board_group_id"
        }
      ]
    },
    "document_versions": {
      "kind": "inherit_visibility",
      "fk_column": "document_id",
      "parent_table": "documents",
      "writer_column": "uploaded_by",
      "insert_privileged_only": true
    },
    "settings": {
      "kind": "app_config"
    },
    "app_settings": {
      "kind": "adult_only"
    }
  },
  "shareable": {
    "document": {
      "table": "documents",
      "title_column": "title",
      "columns": [
        { "column": "doc_type", "label": "Type",
          "value_labels": { "ccr": "CC&Rs", "bylaws": "Bylaws", "rules": "Rules & Regulations", "architectural": "Architectural Guidelines", "other": "Other", "agenda": "Agenda", "minutes": "Minutes" } },
        { "column": "description", "label": "About", "format": "multiline" },
        { "column": "meeting_date", "label": "Meeting date", "format": "date" },
        { "column": "updated_at", "label": "Last updated", "format": "date" }
      ],
      "visible_where": { "column": "visibility", "values": ["everyone"] },
      "feed": {
        "label": "Current version",
        "table": "document_versions",
        "fk_column": "document_id",
        "columns": [
          { "column": "version_number", "label": "Version", "format": "number", "role": "detail" },
          { "column": "uploaded_at", "label": "Uploaded", "format": "date", "role": "detail" },
          { "column": "change_note", "label": "What changed", "format": "multiline", "role": "body" }
        ],
        "files_column": "file_id",
        "order_column": "version_number",
        "order": "newest",
        "max_items": 1
      }
    }
  },
  "delete_file_columns": {
    "document_versions": [
      "file_id"
    ]
  },
  "admin_config": {
    "settings_table": "settings",
    "keys": [
      "board_group_id"
    ]
  },
  "agenda": {
    "kind": "event",
    "label": "Meeting",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, NULLIF(description, '') AS subtitle, meeting_date AS when_at FROM app_document_library__documents WHERE category = 'meeting' AND doc_type = 'agenda' AND meeting_date = :today LIMIT 10"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_document_library__documents WHERE category = 'meeting' AND doc_type = 'agenda' AND meeting_date >= :today AND meeting_date <= date(:today, '+13 days') LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "meetings in the next two weeks",
      "severity": "info"
    }
  },
  "publishes": [
    "document.published",
    "document.revised"
  ],
  "publish_acls": {
    "document.published": {
      "require_group_setting": {
        "settings_table": "settings",
        "settings_key": "board_group_id"
      }
    },
    "document.revised": {
      "require_group_setting": {
        "settings_table": "settings",
        "settings_key": "board_group_id"
      }
    }
  },
  "file_acls": {
    "write": {
      "require_group_setting": {
        "settings_table": "settings",
        "settings_key": "board_group_id"
      }
    }
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "governing_documents",
      "meeting_archive"
    ]
  }
}
